<Page
    x:Class="Explorium.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Explorium"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#FF1F1F1F">

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Browser toolbar -->
        <Grid Grid.Row="0" Background="#FF111111">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>

            <!-- Back -->
            <Button
                Grid.Column="0"
                Content="←"
                FontSize="28"
                Background="Transparent"
                Foreground="White"
                BorderBrush="Transparent"/>

            <!-- Forward -->
            <Button
                Grid.Column="1"
                Content="→"
                FontSize="28"
                Background="Transparent"
                Foreground="White"
                BorderBrush="Transparent"/>

            <!-- Reload -->
            <Button
                Grid.Column="2"
                Content="⟳"
                FontSize="28"
                Background="Transparent"
                Foreground="White"
                BorderBrush="Transparent"/>

            <!-- Address bar -->
            <TextBox
                Grid.Column="3"
                Margin="10,25,10,25"
                FontSize="20"
                Text="http://"
                Background="#FF2B2B2B"
                Foreground="White"
                BorderBrush="#FF555555"
                Padding="12,5"/>

            <!-- Menu -->
            <Button
                Grid.Column="4"
                Content="⋯"
                FontSize="28"
                Background="Transparent"
                Foreground="White"
                BorderBrush="Transparent"/>

        </Grid>

        <!-- Start page -->
        <ScrollViewer Grid.Row="1">

            <StackPanel
                Margin="80,60,80,80"
                HorizontalAlignment="Left">

                <TextBlock
                    Text="Explorium"
                    FontSize="64"
                    Foreground="White"
                    Margin="0,0,0,10"/>

                <TextBlock
                    Text="Explore the web."
                    FontSize="24"
                    Foreground="#FFAAAAAA"
                    Margin="0,0,0,50"/>

                <!-- Metro tiles -->
                <Grid Width="700">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="140"/>
                        <RowDefinition Height="140"/>
                    </Grid.RowDefinitions>

                    <!-- Search -->
                    <Button
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="4"
                        Background="#FF0078D7"
                        Foreground="White"
                        BorderBrush="Transparent">

                        <StackPanel>
                            <TextBlock
                                Text="⌕"
                                FontSize="42"/>
                            <TextBlock
                                Text="Search"
                                FontSize="20"/>
                        </StackPanel>

                    </Button>

                    <!-- Favorites -->
                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="4"
                        Background="#FF107C10"
                        Foreground="White"
                        BorderBrush="Transparent">

                        <StackPanel>
                            <TextBlock
                                Text="★"
                                FontSize="42"/>
                            <TextBlock
                                Text="Favorites"
                                FontSize="20"/>
                        </StackPanel>

                    </Button>

                    <!-- History -->
                    <Button
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="4"
                        Background="#FF6A00FF"
                        Foreground="White"
                        BorderBrush="Transparent">

                        <StackPanel>
                            <TextBlock
                                Text="◷"
                                FontSize="42"/>
                            <TextBlock
                                Text="History"
                                FontSize="20"/>
                        </StackPanel>

                    </Button>

                    <!-- Settings -->
                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="4"
                        Background="#FF444444"
                        Foreground="White"
                        BorderBrush="Transparent">

                        <StackPanel>
                            <TextBlock
                                Text="⚙"
                                FontSize="42"/>
                            <TextBlock
                                Text="Settings"
                                FontSize="20"/>
                        </StackPanel>

                    </Button>

                    <!-- About -->
                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="4"
                        Background="#FF333333"
                        Foreground="White"
                        BorderBrush="Transparent">

                        <StackPanel>
                            <TextBlock
                                Text="i"
                                FontSize="42"/>
                            <TextBlock
                                Text="About Explorium"
                                FontSize="20"/>
                        </StackPanel>

                    </Button>

                </Grid>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>